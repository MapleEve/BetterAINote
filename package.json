{
    "name": "betterainote",
    "version": "0.6.1-preview",
    "private": true,
    "packageManager": "bun@1.2.20",
    "description": "Private self-hosted workspace for multi-platform voice record aggregation and unified management",
    "author": "BetterAINote Contributors",
    "license": "SEE LICENSE IN LICENSE",
    "keywords": [
        "BetterAINote",
        "private-voice-workspace",
        "multiplatform-recordings",
        "private-meeting-notes",
        "voice-notes",
        "recording-management",
        "recording-import",
        "transcription",
        "speaker-diarization",
        "TicNote",
        "DingTalk",
        "self-hosted",
        "meeting-notes",
        "voice-recorder",
        "Plaud",
        "search-ready",
        "ai",
        "nextjs",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MapleEve/BetterAINote.git"
    },
    "homepage": "https://github.com/MapleEve/BetterAINote#readme",
    "bugs": {
        "url": "https://github.com/MapleEve/BetterAINote/issues"
    },
    "scripts": {
        "dev": "node scripts/dev-with-worker.mjs",
        "dev:web": "PORT=${PORT:-3001} WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=1 node scripts/run-with-local-env.mjs next dev --webpack",
        "dev:turbo": "PORT=${PORT:-3001} node scripts/run-with-local-env.mjs next dev",
        "build": "next build",
        "start": "PORT=${PORT:-3001} node scripts/run-with-local-env.mjs next start",
        "worker": "node scripts/run-with-local-env.mjs bun src/worker/index.ts",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=junit.xml",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "e2e:display": "playwright test e2e/display-settings-language.spec.ts",
        "type-check": "tsc --noEmit",
        "format-and-lint": "biome check .",
        "format-and-lint:fix": "biome check . --write",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node scripts/run-with-local-env.mjs bun src/db/migrate.ts",
        "search:rebuild": "node scripts/rebuild-search-index.mjs",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@libsql/client": "0.17.3",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-label": "2.1.8",
        "@radix-ui/react-select": "2.2.6",
        "@radix-ui/react-slider": "1.3.6",
        "@radix-ui/react-slot": "1.2.4",
        "@radix-ui/react-switch": "1.2.6",
        "better-auth": "1.6.9",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "date-fns": "4.1.0",
        "drizzle-orm": "0.45.2",
        "lucide-react": "0.554.0",
        "nanoid": "5.1.6",
        "next": "16.2.4",
        "next-themes": "0.4.6",
        "openai": "6.9.1",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "sonner": "2.0.7",
        "tailwind-merge": "3.4.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.7",
        "@playwright/test": "1.59.1",
        "@tailwindcss/postcss": "4.2.4",
        "@types/node": "20.19.25",
        "@types/react": "19.2.6",
        "@types/react-dom": "19.2.3",
        "@vitest/coverage-v8": "4.1.5",
        "drizzle-kit": "0.31.10",
        "tailwindcss": "4.2.4",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3",
        "vitest": "4.1.5"
    },
    "overrides": {
        "defu": "6.1.5",
        "picomatch": "4.0.4",
        "postcss": "8.5.10",
        "rollup": "4.59.0",
        "vite": "7.3.2"
    }
}
